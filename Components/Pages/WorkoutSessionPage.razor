@page "/workout-session/{WorkoutId:int}"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@using FitSite.Data
@using FitSite.Data.Models
@using Microsoft.EntityFrameworkCore
@attribute [Authorize]
@rendermode InteractiveServer
@inject AppDbContext Db
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<MudContainer MaxWidth="MaxWidth.Small" Class="py-6">
    <MudStack Spacing="2">
        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="GoBack">
            Back to Workouts
        </MudButton>

        @if (workout is null)
        {
            <MudText Typo="Typo.body1">The requested workout could not be found.</MudText>
        }
        else
        {
            <MudCard>
                <MudCardContent>
                    <MudText Typo="Typo.h5">@workout.Name</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Tertiary" Class="mb-3">
                        Select a rest period and begin your session.
                    </MudText>

                    <MudGrid Spacing="2" Class="mb-3">
                        <MudItem xs="8">
                            <MudNumericField T="int"
                                         Label="Rest Time (seconds)"
                                         Value="restSeconds"
                                         ValueChanged="@(value => restSeconds = value)"
                                         Min="5"
                                         Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="4">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       FullWidth="true"
                                       OnClick="StartWorkout"
                                       Disabled="@(isWorkoutStarted || exercisePlan.Count == 0)">
                                Begin Workout
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>

            @if (isWorkoutStarted)
            {
                <MudCard>
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle1">Current Exercise</MudText>
                        <MudText Typo="Typo.h6" Class="mb-2">@currentExerciseName</MudText>

                        <MudText Typo="Typo.body2" Color="Color.Tertiary" Class="mb-3">
                            Enter the reps and weight for the current set.
                        </MudText>

                        <MudGrid Spacing="2" Class="mb-3">
                            <MudItem xs="6">
                                <MudNumericField T="int"
                 Label="Reps"
                 Value="currentSetReps"
                 ValueChanged="@(value => currentSetReps = value)"
                 Min="1"
                 Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudNumericField T="decimal"
                 Label="Weight (lbs)"
                 Value="currentSetWeight"
                 ValueChanged="@(value => currentSetWeight = value)"
                 Min="0"
                 Variant="Variant.Outlined" />
                            </MudItem>
                        </MudGrid>
<MudText Typo="Typo.body2" Color="Color.Tertiary" Class="mb-2">
    Set @(completedSetsForCurrentExercise + 1) of @exercisePlan[currentExerciseIndex].TargetSets
</MudText>
                                            <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               OnClick="RecordSet"
                               Disabled="@(isResting || workoutComplete || string.IsNullOrWhiteSpace(currentExerciseName))">
                        End Set
                    </MudButton>

                        @if (isResting)
{
    <div class="rest-overlay" role="status" aria-live="polite">
        <div class="rest-overlay-content">
            <div class="rest-label">Rest</div>
            <div class="rest-seconds">@remainingRestSeconds</div>
            <div class="rest-unit">seconds</div>
        </div>
    </div>
}
                    </MudCardContent>
                </MudCard>

                <MudCard>
                    <MudCardHeader>
                        <MudText Typo="Typo.subtitle1">Recent History</MudText>
                    </MudCardHeader>
                    <MudCardContent>
                        @if (historicalEntries.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Tertiary">
                                No prior history for this exercise yet.
                            </MudText>
                        }
                        else
                        {
                            <MudStack Spacing="1">
                                @foreach (var entry in historicalEntries)
                                {
                                    <MudPaper Class="pa-3" Outlined="true">
                                        <MudText Typo="Typo.body2">
                                            @entry.Reps reps × @entry.WeightLbs lbs
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Tertiary">
                                            Logged @entry.LoggedUtc.ToLocalTime().ToString("MMM d, yyyy • h:mm tt")
                                        </MudText>
                                    </MudPaper>
                                }
                            </MudStack>
                        }
                    </MudCardContent>
                </MudCard>

                @if (workoutComplete)
                {
                    <MudAlert Severity="Severity.Success" Class="mt-3">
                        Workout complete. Great work.
                    </MudAlert>

                    <MudButton Variant="Variant.Filled"
               Color="Color.Success"
               Class="mt-2"
               OnClick="EndWorkoutAndReturnToDashboard">
                        End Workout Session
                    </MudButton>
                }
            }
        }
    </MudStack>
</MudContainer>

@code {
    private record ExercisePlanItem(string Name, int TargetSets, int DefaultReps, decimal DefaultWeight);
private List<ExercisePlanItem> exercisePlan = [];
private int completedSetsForCurrentExercise;
private bool workoutComplete;
    [Parameter] public int WorkoutId { get; set; }

    private string? userId;
    private WorkoutSession? workout;
    private List<ExerciseLog> workoutExercises = [];
    private List<string> exerciseNames = [];
    private List<ExerciseLog> historicalEntries = [];

    private bool isWorkoutStarted;
    private bool isResting;
    private int restSeconds = 30;
    private int remainingRestSeconds;
    private int currentExerciseIndex;
    private string? currentExerciseName;
    private int currentSetReps = 10;
    private decimal currentSetWeight;
    private CancellationTokenSource? restTimerCts;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrWhiteSpace(userId)) return;

        workout = await Db.WorkoutSessions
            .FirstOrDefaultAsync(w => w.Id == WorkoutId && w.UserId == userId);

        if (workout is null) return;

        workoutExercises = await Db.ExerciseLogs
            .Where(e => e.WorkoutSessionId == WorkoutId && e.UserId == userId)
            .OrderBy(e => e.LoggedUtc)
            .ThenBy(e => e.Id)
            .ToListAsync();

        var planItems = await Db.WorkoutPlanItems
            .Where(p => p.WorkoutSessionId == WorkoutId && p.UserId == userId)
            .OrderBy(p => p.DisplayOrder)
            .ThenBy(p => p.Id)
            .ToListAsync();

exercisePlan = planItems
    .Select(p => new ExercisePlanItem(
        p.ExerciseName.Trim(),
        Math.Max(1, p.Sets),
        Math.Max(1, p.Reps),
        p.WeightLbs))
    .ToList();

exerciseNames = exercisePlan.Select(p => p.Name).ToList();
    }

    private async Task StartWorkout()
{
    if (workout is null || exercisePlan.Count == 0) return;

    currentExerciseIndex = 0;
    isWorkoutStarted = true;
    isResting = false;
    workoutComplete = false;

    var current = exercisePlan[currentExerciseIndex];
    currentExerciseName = current.Name;
    currentSetReps = current.DefaultReps;
    currentSetWeight = current.DefaultWeight;
    completedSetsForCurrentExercise = 0;

    await LoadHistoricalEntries();
}

    private async Task RecordSet()
    {
        if (workout is null || string.IsNullOrWhiteSpace(userId) || string.IsNullOrWhiteSpace(currentExerciseName)) return;

        var entry = new ExerciseLog
        {
            UserId = userId,
            WorkoutSessionId = workout.Id,
            ExerciseName = currentExerciseName,
            Sets = 1,
            Reps = currentSetReps,
            WeightLbs = currentSetWeight,
            LoggedUtc = DateTime.UtcNow
        };

        Db.ExerciseLogs.Add(entry);
        await Db.SaveChangesAsync();

        await LoadHistoricalEntries();
        completedSetsForCurrentExercise++;

var current = exercisePlan[currentExerciseIndex];
var reachedTarget = completedSetsForCurrentExercise >= current.TargetSets;

if (reachedTarget)
{
    if (currentExerciseIndex < exercisePlan.Count - 1)
    {
        currentExerciseIndex++;
        var next = exercisePlan[currentExerciseIndex];

        currentExerciseName = next.Name;
        currentSetReps = next.DefaultReps;
        currentSetWeight = next.DefaultWeight;
        completedSetsForCurrentExercise = 0;

        await LoadHistoricalEntries();
    }
    else
    {
        workoutComplete = true;
        isResting = false;
        return;
    }
}

await StartRestTimer();
    }

    private async Task StartRestTimer()
    {
        if (restSeconds < 1) return;

        isResting = true;
        remainingRestSeconds = restSeconds;
        restTimerCts?.Cancel();
        restTimerCts = new CancellationTokenSource();
        var token = restTimerCts.Token;

        try
        {
            while (remainingRestSeconds > 0)
            {
                await Task.Delay(1000, token);
                remainingRestSeconds--;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException) { }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                isResting = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task LoadHistoricalEntries()
    {
        if (string.IsNullOrWhiteSpace(userId) || string.IsNullOrWhiteSpace(currentExerciseName))
        {
            historicalEntries = [];
            return;
        }

        historicalEntries = await Db.ExerciseLogs
            .Where(e => e.UserId == userId
                && e.ExerciseName.ToLower() == currentExerciseName.ToLower()
                && e.WorkoutSessionId != workout!.Id)
            .OrderByDescending(e => e.LoggedUtc)
            .Take(6)
            .ToListAsync();
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/workouts");
    }
    private void EndWorkoutAndReturnToDashboard()
{
    NavigationManager.NavigateTo("/dashboard");
}
}

<style>
.rest-overlay {
    position: fixed;
    inset: 0;
    z-index: 1400;
    background: rgba(0, 0, 0, 0.72);
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(2px);
}

.rest-overlay-content {
    text-align: center;
    color: #ffffff;
    padding: 1rem;
}

.rest-label {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.92;
    margin-bottom: 0.35rem;
}

.rest-seconds {
    font-size: clamp(4rem, 16vw, 9rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.03em;
    text-shadow: 0 6px 18px rgba(0, 0, 0, 0.4);
}

.rest-unit {
    margin-top: 0.5rem;
    font-size: 1rem;
    font-weight: 700;
    opacity: 0.85;
}
</style>