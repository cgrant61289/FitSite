@page "/dashboard"
@using FitSite.Data
@using FitSite.Data.Models
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]
@inject HttpClient HttpClient
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@using MudBlazor

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
    <MudText Typo="Typo.h3" Class="mb-6">Dashboard</MudText>

    @if (isLoading)
    {
        <MudProgressCircular IsIndeterminate="true" />
    }
    else if (dashboardStats != null)
    {
        <MudGrid Spacing="2" Class="mb-6">
            <MudItem xs="12" sm="6" md="3">
                <MudCard>
                    <MudCardContent>
                        <MudText Typo="Typo.body2" Color="Color.Tertiary">Workouts This Month</MudText>
                        <MudText Typo="Typo.h4">@dashboardStats.WorkoutsThisMonth</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard>
                    <MudCardContent>
                        <MudText Typo="Typo.body2" Color="Color.Tertiary">Calories Burned</MudText>
                        <MudText Typo="Typo.h4">@dashboardStats.TotalCaloriesThisMonth</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard>
                    <MudCardContent>
                        <MudText Typo="Typo.body2" Color="Color.Tertiary">Current Weight</MudText>
                        <MudText Typo="Typo.h4">@(dashboardStats.CurrentWeight?.ToString("F1") ?? "—") lbs</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard>
                    <MudCardContent>
                        <MudText Typo="Typo.body2" Color="Color.Tertiary">Last Workout</MudText>
                        <MudText Typo="Typo.h4">@(dashboardStats.LastWorkout?.ToString("MMM d") ?? "—")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <MudCard>
                    <MudCardHeader>
                        <MudText Typo="Typo.h6">Recent Workouts</MudText>
                    </MudCardHeader>
                    <MudCardContent>
                        @if (exerciseProgressions?.Count > 0)
{
@foreach (var exercise in exerciseProgressions)
{
<MudPaper Class="pa-3 mb-3" Outlined="true">
<MudText Typo="Typo.subtitle2" Class="mb-2">@exercise.Exercise</MudText>

@if (exercise.Points.Count > 1)
{
<MudChart T="double" ChartType="ChartType.Line" ChartSeries="@BuildSeries(exercise)" XAxisLabels="@BuildLabels(exercise)" Width="100%" Height="250px" />
}
else if (exercise.Points.Count == 1)
{
<MudText Typo="Typo.body2" Color="Color.Tertiary">
Only one data point so far: @exercise.Points[0].WeightLbs lbs
</MudText>
}
else
{
<MudText Typo="Typo.body2" Color="Color.Tertiary">
No data yet.
</MudText>
}
</MudPaper>
}
}
else
{
<MudText Typo="Typo.body2" Color="Color.Tertiary">No exercise progression data yet</MudText>
}
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudCard>
                    <MudCardHeader>
                        <MudText Typo="Typo.h6">Personal Records</MudText>
                    </MudCardHeader>
                    <MudCardContent>
                        @if (personalRecords?.Count > 0)
                        {
                            <MudList T="PersonalRecordDto" Dense="true">
    @foreach (var record in personalRecords)
    {
        <MudListItem T="PersonalRecordDto">
            <MudText Typo="Typo.body2">@record.Exercise</MudText>
            <MudText Typo="Typo.caption" Color="Color.Tertiary">
                @record.MaxWeight lbs • @record.MaxReps reps
            </MudText>
        </MudListItem>
    }
</MudList>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Tertiary">No exercises logged yet</MudText>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private List<ExerciseProgressionDto>? exerciseProgressions;
    private bool isLoading = true;
    private DashboardStatsDto? dashboardStats;
    private List<RecentWorkoutDto>? recentWorkouts;
    private List<PersonalRecordDto>? personalRecords;
    private string? userId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (userId != null)
        {
            await LoadDashboardData();
        }
    }

    private async Task LoadDashboardData()
{
    try
    {
        var statsUrl = Navigation.ToAbsoluteUri($"/api/dashboard/stats/{userId}");
        var recentUrl = Navigation.ToAbsoluteUri($"/api/dashboard/recent-workouts/{userId}");
        var recordsUrl = Navigation.ToAbsoluteUri($"/api/dashboard/personal-records/{userId}");
        var progressionUrl = Navigation.ToAbsoluteUri($"/api/dashboard/exercise-progression/{userId}");
        
        exerciseProgressions = await HttpClient.GetFromJsonAsync<List<ExerciseProgressionDto>>(progressionUrl);
        dashboardStats = await HttpClient.GetFromJsonAsync<DashboardStatsDto>(statsUrl);
        recentWorkouts = await HttpClient.GetFromJsonAsync<List<RecentWorkoutDto>>(recentUrl);
        personalRecords = await HttpClient.GetFromJsonAsync<List<PersonalRecordDto>>(recordsUrl);
    }
    finally
    {
        isLoading = false;
    }
} 

    private class DashboardStatsDto
    {
        public DateTime? LastWorkout { get; set; }
        public int WorkoutsThisMonth { get; set; }
        public long TotalCaloriesThisMonth { get; set; }
        public decimal? CurrentWeight { get; set; }
        public List<WeightHistoryDto> WeightHistory { get; set; } = [];
    }

    private class RecentWorkoutDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public int DurationMinutes { get; set; }
        public int CaloriesBurned { get; set; }
        public DateTime? CompletedDate { get; set; }
    }

    private class PersonalRecordDto
    {
        public string Exercise { get; set; } = "";
        public decimal MaxWeight { get; set; }
        public int MaxReps { get; set; }
    }

    private class WeightHistoryDto
    {
        public DateTime Date { get; set; }
        public decimal? Weight { get; set; }
    }
    private class ExerciseProgressionDto
{
public string Exercise { get; set; } = "";
public List<ExerciseProgressionPointDto> Points { get; set; } = [];
}

private class ExerciseProgressionPointDto
{
public DateTime LoggedUtc { get; set; }
public decimal WeightLbs { get; set; }
}

private List<ChartSeries<double>> BuildSeries(ExerciseProgressionDto exercise)
{
return new List<ChartSeries<double>>
{
new ChartSeries<double>
{
Name = "Weight (lbs)",
Data = exercise.Points.Select(p => (double)p.WeightLbs).ToArray()
}
};
}

private string[] BuildLabels(ExerciseProgressionDto exercise)
{
return exercise.Points
.Select(p => p.LoggedUtc.ToLocalTime().ToString("M/d"))
.ToArray();
}
}