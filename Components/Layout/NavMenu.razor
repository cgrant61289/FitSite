@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using FitSite.Data.Models
@using Microsoft.AspNetCore.Identity
@using MudBlazor
@using MudBlazor.Components
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Navigation

<MudNavMenu>
    <MudNavLink Href="/" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
    <MudNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
    <AuthorizeView>
        <Authorized>
    <MudDivider Class="my-2" />
    <MudButton Variant="Variant.Text"
           Color="Color.Inherit"
           StartIcon="@Icons.Material.Filled.Logout"
           OnClick="@(() => Navigation.NavigateTo("/logout", forceLoad: true))">
    Logout
</MudButton>
</Authorized>
<NotAuthorized>
    <MudDivider Class="my-2" />
    <MudNavLink Href="/login" Icon="@Icons.Material.Filled.Login">Login</MudNavLink>
    <MudNavLink Href="/register" Icon="@Icons.Material.Filled.AppRegistration">Register</MudNavLink>
</NotAuthorized>
    </AuthorizeView>
</MudNavMenu>

